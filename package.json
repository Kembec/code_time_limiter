{
	"name": "code-time-limiter",
	"displayName": "%displayName%",
	"description": "%description%",
	"version": "0.0.2",
	"publisher": "kembec",
	"engines": {
		"vscode": "^1.86.0"
	},
	"categories": [
		"Visualization",
		"Education",
		"Other"
	],
	"keywords": [
		"code time",
		"code",
		"codetime",
		"flow",
		"focus",
		"limite",
		"limiter",
		"metrics",
		"productivity",
		"standup",
		"time tracker",
		"time tracking",
		"time",
		"timer",
		"todo",
		"tracker",
		"tracking"
	],
	"activationEvents": [
		"onStartupFinished"
	],
	"icon": "images/icon.png",
	"galleryBanner": {
		"color": "#000000",
		"theme": "dark"
	},
	"l10n": "./l10n",
	"main": "src/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "codeTimeLimiter.setLimit",
				"title": "%command.setLimit%",
				"category": "%category%",
				"icon": "$(watch)"
			},
			{
				"command": "codeTimeLimiter.addFive",
				"title": "%command.addFive%",
				"category": "%category%"
			},
			{
				"command": "codeTimeLimiter.stop",
				"title": "%command.stop%",
				"category": "%category%"
			},
			{
				"command": "codeTimeLimiter.toggleActivate",
				"title": "%command.toggle%",
				"category": "%category%"
			}
		],
		"configuration": {
			"type": "object",
			"title": "%category%",
			"properties": {
				"codeTimeLimiter.enableAtStartup": {
					"type": "boolean",
					"default": false,
					"description": "%config.enableAtStartup%"
				}
			}
		}
	},
	"scripts": {
		"lint": "eslint .",
		"pretest": "npm run lint",
		"test": "vscode-test",
		"test:unit": "node --test test/unit/",
		"deploy": "vsce publish"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Kembec/code_time_limiter.git"
	},
	"author": "Kembec.com",
	"license": "AGPL-3.0 license",
	"bugs": {
		"url": "https://github.com/Kembec/code_time_limiter/issues"
	},
	"homepage": "https://github.com/Kembec/code_time_limiter#readme",
	"devDependencies": {
		"@kembec/eslint-config": "^1.1.0",
		"@types/mocha": "^10.0.6",
		"@types/node": "18.x",
		"@types/vscode": "^1.86.0",
		"@vscode/test-cli": "^0.0.15",
		"@vscode/test-electron": "^3.1.0",
		"@vscode/vsce": "^2.23.0",
		"eslint": "^8.56.0",
		"sinon": "^17.0.1",
		"typescript": "^5.3.3"
	}
}
