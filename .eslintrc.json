{
	"extends": ["@kembec/eslint-config"],
	"rules": {
		"no-const-assign": "warn",
		"no-this-before-super": "warn",
		"no-undef": "warn",
		"no-unreachable": "warn",
		"no-unused-vars": "warn",
		"constructor-super": "warn",
		"valid-typeof": "warn"
	},
	"overrides": [{ "files": ["test/integration/**/*.js"], "env": { "mocha": true } }]
}
